#!/usr/bin/env python3
"""Check a .v file against a warm `rocq` session.  See README.md."""
import os
import sys

# realpath, not abspath: this script is meant to be symlinked onto PATH, and
# abspath would then look for the package next to the SYMLINK.
HERE = os.path.dirname(os.path.realpath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

try:
    from rocqwarm.client import main
except ImportError as e:                                    # noqa: BLE001
    sys.exit("rocq-warm: cannot find the rocqwarm package next to %s (%s).\n"
             "Keep `rocq-warm` beside `rocqwarm/`, or symlink it here from "
             "anywhere on PATH." % (os.path.realpath(__file__), e))

sys.exit(main())
